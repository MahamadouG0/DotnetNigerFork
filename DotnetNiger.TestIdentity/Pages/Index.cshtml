@page
@{
    ViewData["Title"] = "TestIdentity";
}
<div class="container py-5">
    <h1 class="fw-bold mb-2">TestIdentity</h1>
    <p class="lead mb-5">Application de test de la connexion OIDC avec DotnetNiger Identity.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="alert alert-success">
            <strong>✅ Connecté en tant que :</strong> @User.Identity.Name
        </div>

        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Revendications (Claims)</h5></div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Valeur</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in User.Claims)
                        {
                            <tr>
                                <td><code>@claim.Type</code></td>
                                <td>@claim.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Tokens</h5></div>
            <div class="card-body">
                @{
                    var accessToken = await HttpContext.GetTokenAsync("access_token");
                    var idToken = await HttpContext.GetTokenAsync("id_token");
                    var refreshToken = await HttpContext.GetTokenAsync("refresh_token");
                }
                @if (!string.IsNullOrEmpty(accessToken))
                {
                    <h6>Access Token</h6>
                    <pre class="bg-light p-3 rounded" style="max-height:100px;overflow:auto;"><code>@accessToken</code></pre>
                }
                @if (!string.IsNullOrEmpty(idToken))
                {
                    <h6>ID Token</h6>
                    <pre class="bg-light p-3 rounded" style="max-height:100px;overflow:auto;"><code>@idToken</code></pre>
                }
                @if (!string.IsNullOrEmpty(refreshToken))
                {
                    <h6>Refresh Token</h6>
                    <pre class="bg-light p-3 rounded" style="max-height:100px;overflow:auto;"><code>@refreshToken</code></pre>
                }
                @if (string.IsNullOrEmpty(accessToken) && string.IsNullOrEmpty(idToken))
                {
                    <p class="text-muted mb-0">Aucun token disponible. (SaveTokens peut être désactivé)</p>
                }
            </div>
        </div>

        <a href="/Account/Logout" class="btn btn-danger">Déconnexion</a>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-shield-lock text-primary" style="font-size:5rem;"></i>
            <h3 class="mt-3 mb-4">Vous n'êtes pas connecté</h3>
            <a href="/Account/Login" class="btn btn-primary btn-lg px-5">Se connecter avec DotnetNiger</a>
        </div>
    }
</div>
