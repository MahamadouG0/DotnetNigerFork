{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=DotnetNigerIdentity.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/identity-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Admin": {
    "DefaultPassword": "__SET_VIA_USER_SECRETS__"
  },
  "RateLimiting": {
    "PermitLimit": 5,
    "WindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@dotnetniger.com",
    "FromName": "DotnetNiger",
    "AppBaseUrl": "http://localhost:5075"
  },
  "Authentication": {
    "Google": {
      "ClientId": "__SET_VIA_USER_SECRETS__",
      "ClientSecret": "__SET_VIA_USER_SECRETS__"
    },
    "Microsoft": {
      "ClientId": "__SET_VIA_USER_SECRETS__",
      "ClientSecret": "__SET_VIA_USER_SECRETS__"
    },
    "GitHub": {
      "ClientId": "__SET_VIA_USER_SECRETS__",
      "ClientSecret": "__SET_VIA_USER_SECRETS__"
    }
  },
  "InternalApiKey": "__SET_VIA_USER_SECRETS__",
  "DeveloperPortal": {
    "GatewayBaseUrl": "http://localhost:5000",
    "MaxServicesPerTenant": 10
  }
}
