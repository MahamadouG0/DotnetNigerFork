@page
@model DotnetNiger.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Inscription";
}

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="error" style="background:#f0fdf4;color:#16a34a">@Model.SuccessMessage</div>
    }

    <div class="form-group">
        <label for="firstName">Prénom</label>
        <input type="text" id="firstName" name="firstName" value="@Model.FirstName" required autofocus
               placeholder="Votre prénom" />
    </div>

    <div class="form-group">
        <label for="lastName">Nom</label>
        <input type="text" id="lastName" name="lastName" value="@Model.LastName" required
               placeholder="Votre nom" />
    </div>

    <div class="form-group">
        <label for="email">Adresse email</label>
        <input type="email" id="email" name="email" value="@Model.Email" required
               placeholder="vous@exemple.com" />
    </div>

    <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" required
               placeholder="Minimum 8 caractères" minlength="8" />
    </div>

    <div class="form-group">
        <label for="confirmPassword">Confirmer le mot de passe</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required
               placeholder="Répétez le mot de passe" minlength="8" />
    </div>

    <button type="submit" style="margin-bottom:12px">Créer mon compte</button>

    <div style="text-align:center;font-size:14px">
        Déjà un compte ?
        <a href="/Account/Login@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : "?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl))"
           style="color:#512BD4;text-decoration:none;font-weight:600">Connectez-vous</a>
    </div>
</form>

@if (Model.ExternalProviders.Count > 0)
{
    <div class="divider">
        <span>Ou</span>
    </div>

    <div class="external-providers">
        @foreach (var provider in Model.ExternalProviders)
        {
            <form asp-page="/Account/Login" asp-page-handler="ExternalLogin" method="post">
                <input type="hidden" name="provider" value="@provider.Name" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn-external btn-@provider.Name.ToLowerInvariant()">
                    @if (provider.Name == "Google")
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                    }
                    else if (provider.Name == "GitHub")
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#333" d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                    }
                    else if (provider.Name == "Microsoft")
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24"><rect x="1" y="1" width="10.5" height="10.5" fill="#f25022"/><rect x="12.5" y="1" width="10.5" height="10.5" fill="#7fba00"/><rect x="1" y="12.5" width="10.5" height="10.5" fill="#00a4ef"/><rect x="12.5" y="12.5" width="10.5" height="10.5" fill="#ffb900"/></svg>
                    }
                    @provider.DisplayName
                </button>
            </form>
        }
    </div>
}

<style>
    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0;
        color: #999;
        font-size: 13px;
    }
    .divider::before, .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: #e0e0e0;
    }
    .external-providers {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .btn-external {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        background: white;
        color: #333;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-external:hover {
        background: #f5f5f5;
    }
    .btn-google { border-color: #4285f4; color: #4285f4; }
    .btn-google:hover { background: #e8f0fe; }
    .btn-github { border-color: #333; color: #333; }
    .btn-github:hover { background: #f0f0f0; }
    .btn-microsoft { border-color: #00a4ef; color: #00a4ef; }
    .btn-microsoft:hover { background: #e6f7ff; }
</style>
