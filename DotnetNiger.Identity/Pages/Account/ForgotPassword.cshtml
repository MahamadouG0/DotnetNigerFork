@page
@model DotnetNiger.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<form method="post">
    @Html.AntiForgeryToken()

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="success">@Model.SuccessMessage</div>
    }

    <div class="form-group">
        <label for="email">Adresse email</label>
        <input type="email" id="email" name="email" required autofocus
               placeholder="vous@exemple.com" />
    </div>

    <button type="submit">Envoyer le lien</button>

    <div style="text-align:center;font-size:14px;margin-top:16px">
        <a href="/Account/Login" style="color:#512BD4;text-decoration:none;font-weight:600">Retour à la connexion</a>
    </div>
</form>

<style>
    .success {
        background: #f0fdf4; color: #16a34a; padding: 10px 14px;
        border-radius: 6px; font-size: 14px; margin-bottom: 16px;
    }
</style>
