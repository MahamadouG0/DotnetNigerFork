        @* ──── Tab 1: Registration ──── *@
        <div class="tab-pane fade show active" id="en-register" role="tabpanel">
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:-2px"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg> Authentication</h5></div>
                <div class="card-body">
                    <p>To use the DotnetNiger API, include your API key in the <code>X-API-Key</code> header.</p>
                    <p>Get your key from the developer dashboard or by creating a tenant.</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:-2px"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/><path d="M5 6.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/></svg> Register an External Service</h5></div>
                <div class="card-body">
                    <p>Register your external API to make it accessible through the Gateway.</p>

                    <h6 class="mt-3">cURL</h6>
                    <pre class="bg-light p-3 rounded"><code>curl -X POST http://localhost:5075/api/v1/external-services/register \
  -H "X-API-Key: dn_your_key" \
  -H "Content-Type: application/json" \
  -d '{
    "name": "My Service",
    "slug": "my-service",
    "baseUrl": "https://api.myservice.com"
  }'</code></pre>

                    <h6 class="mt-3">Python</h6>
                    <pre class="bg-light p-3 rounded"><code>import requests

response = requests.post(
    "http://localhost:5075/api/v1/external-services/register",
    json={
        "name": "My Service",
        "slug": "my-service",
        "baseUrl": "https://api.myservice.com"
    },
    headers={"X-API-Key": "dn_your_key"}
)
print(response.json())</code></pre>

                    <h6 class="mt-3">Node.js</h6>
                    <pre class="bg-light p-3 rounded"><code>const response = await axios.post(
  'http://localhost:5075/api/v1/external-services/register',
  {
    name: 'My Service',
    slug: 'my-service',
    baseUrl: 'https://api.myservice.com'
  },
  { headers: { 'X-API-Key': 'dn_your_key' } }
);
console.log(response.data);</code></pre>

                    <h6 class="mt-3">C#</h6>
                    <pre class="bg-light p-3 rounded"><code>using var client = new HttpClient();
client.DefaultRequestHeaders.Add("X-API-Key", "dn_your_key");

var payload = new {
    name = "My Service",
    slug = "my-service",
    baseUrl = "https://api.myservice.com"
};

var response = await client.PostAsJsonAsync(
    "http://localhost:5075/api/v1/external-services/register", payload);
var result = await response.Content.ReadFromJsonAsync&lt;ExternalServiceResponse&gt;();</code></pre>

                    <h6 class="mt-3">Java</h6>
                    <pre class="bg-light p-3 rounded"><code>OkHttpClient client = new OkHttpClient();

String json = "{"
    + "\"name\":\"My Service\","
    + "\"slug\":\"my-service\","
    + "\"baseUrl\":\"https://api.myservice.com\""
    + "}";

Request request = new Request.Builder()
    .url("http://localhost:5075/api/v1/external-services/register")
    .addHeader("X-API-Key", "dn_your_key")
    .post(RequestBody.create(json, MediaType.parse("application/json")))
    .build();

Response response = client.newCall(request).execute();</code></pre>

                    <h6 class="mt-3">Go</h6>
                    <pre class="bg-light p-3 rounded"><code>package main

import (
    "bytes"
    "encoding/json"
    "net/http"
)

func main() {
    payload := map[string]string{
        "name":    "My Service",
        "slug":    "my-service",
        "baseUrl": "https://api.myservice.com",
    }
    body, _ := json.Marshal(payload)

    req, _ := http.NewRequest("POST",
        "http://localhost:5075/api/v1/external-services/register",
        bytes.NewBuffer(body))
    req.Header.Set("X-API-Key", "dn_your_key")

    client := &http.Client{}
    resp, _ := client.Do(req)
    defer resp.Body.Close()
}</code></pre>

                    <h6 class="mt-3">Rust</h6>
                    <pre class="bg-light p-3 rounded"><code>use reqwest;
use serde_json::json;

#[tokio::main]
async fn main() {
    let client = reqwest::Client::new();
    let response = client
        .post("http://localhost:5075/api/v1/external-services/register")
        .header("X-API-Key", "dn_your_key")
        .json(&json!({
            "name": "My Service",
            "slug": "my-service",
            "baseUrl": "https://api.myservice.com"
        }))
        .send()
        .await
        .unwrap();
}</code></pre>

                    <h6 class="mt-3">PHP</h6>
                    <pre class="bg-light p-3 rounded"><code>$ch = curl_init("http://localhost:5075/api/v1/external-services/register");
curl_setopt($ch, CURLOPT_POST, true);
curl_setopt($ch, CURLOPT_HTTPHEADER, [
    "X-API-Key: dn_your_key",
    "Content-Type: application/json"
]);
curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode([
    "name" => "My Service",
    "slug" => "my-service",
    "baseUrl" => "https://api.myservice.com"
]));
$response = curl_exec($ch);
curl_close($ch);</code></pre>

                    <h6 class="mt-3">Ruby</h6>
                    <pre class="bg-light p-3 rounded"><code>require 'net/http'
require 'json'

uri = URI("http://localhost:5075/api/v1/external-services/register")
request = Net::HTTP::Post.new(uri)
request["X-API-Key"] = "dn_your_key"
request.body = {
  name: "My Service",
  slug: "my-service",
  baseUrl: "https://api.myservice.com"
}.to_json

response = Net::HTTP.start(uri.host, uri.port) { |http| http.request(request) }</code></pre>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:-2px"><path d="M1 2.828c.885-.37 2.154-.769 4-.9V13.5c-1.842.115-3.114.51-4 .9V2.828zM5 .5c1.84-.13 3.366-.065 5 .065V12.9c-1.634-.13-3.16-.195-5-.065V.5zM15 2.828v10.472c-.815-.345-1.983-.668-3-.747V1.97c1.148.059 2.31.36 3 .858zM10 1.23c1.16-.13 2.322-.208 3-.166V12.9c-.678.042-1.84.036-3-.166V1.23z"/></svg> Get an OIDC Token</h5></div>
                <div class="card-body">
                    <p><strong>Password</strong> flow (for your own back-end apps):</p>
                    <pre class="bg-light p-3 rounded"><code>curl -X POST @Model.IdentityUrl/connect/token \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "grant_type=password" \
  -d "username=user@example.com" \
  -d "password=Password123" \
  -d "scope=openid profile email roles offline_access"</code></pre>

                    <p class="mt-3"><strong>Client credentials</strong> flow (for APIs):</p>
                    <pre class="bg-light p-3 rounded"><code>curl -X POST @Model.IdentityUrl/connect/token \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "grant_type=client_credentials" \
  -d "client_id=your_client_id" \
  -d "client_secret=your_client_secret" \
  -d "scope=api"</code></pre>
                </div>
            </div>

            @* ──── Card: Manage API Keys ──── *@
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:-2px"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg> Manage API Keys</h5></div>
                <div class="card-body">
                    <p>Create, list, rotate, and delete your API keys from the dashboard or via the API.</p>

                    <h6 class="mt-3">cURL — List keys</h6>
                    <pre class="bg-light p-3 rounded"><code>curl -X GET http://localhost:5075/api/v1/admin/tenants/{tenantId}/api-keys \
  -H "Authorization: Bearer {token}"</code></pre>

                    <h6 class="mt-3">cURL — Create a key</h6>
                    <pre class="bg-light p-3 rounded"><code>curl -X POST http://localhost:5075/api/v1/admin/tenants/{tenantId}/api-keys \
  -H "Authorization: Bearer {token}" \
  -H "Content-Type: application/json" \
  -d '{"name": "My prod key", "scopes": ["api"]}'</code></pre>

                    <h6 class="mt-3">cURL — Rotate a key</h6>
                    <pre class="bg-light p-3 rounded"><code>curl -X POST http://localhost:5075/api/v1/admin/tenants/{tenantId}/api-keys/{keyId}/rotate \
  -H "Authorization: Bearer {token}"</code></pre>

                    <h6 class="mt-3">cURL — Delete a key</h6>
                    <pre class="bg-light p-3 rounded"><code>curl -X DELETE http://localhost:5075/api/v1/admin/tenants/{tenantId}/api-keys/{keyId} \
  -H "Authorization: Bearer {token}"</code></pre>
                </div>
            </div>

            @* ──── Card: Update a Service (PATCH) ──── *@
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:-2px"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10z"/></svg> Update a Service (PATCH)</h5></div>
                <div class="card-body">
                    <p>Update the URL, description or health endpoint of a registered service.</p>

                    <h6 class="mt-3">cURL</h6>
                    <pre class="bg-light p-3 rounded"><code>curl -X PATCH http://localhost:5075/api/v1/external-services/{serviceId} \
  -H "X-API-Key: dn_your_key" \
  -H "Content-Type: application/json" \
  -d '{"baseUrl": "https://new-url.com", "description": "Updated"}'</code></pre>

                    <h6 class="mt-3">Python</h6>
                    <pre class="bg-light p-3 rounded"><code>import requests
response = requests.patch(
    "http://localhost:5075/api/v1/external-services/{id}",
    json={"baseUrl": "https://new-url.com"},
    headers={"X-API-Key": "dn_your_key"}
)
print(response.json())</code></pre>
                </div>
            </div>
        </div>

        @* ──── Tab 2: Gateway ──── *@
        <div class="tab-pane fade" id="en-gateway" role="tabpanel">
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:-2px"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zM2.04 4.81A6.503 6.503 0 0 1 7 1.18v.7c0 .6-.4 1.1-.9 1.4l-.5.3c-.5.3-.6.9-.3 1.3l.3.4c.2.3.3.7.1 1.1l-.4.7c-.2.3-.5.5-.9.5h-.3c-.6 0-1.1.5-1.1 1.1v.7c0 .6-.5 1.1-1.1 1.1-.2 0-.3 0-.5-.1l-.5-.3a6.44 6.44 0 0 1-1.32-3.97zm7.85 8.55A6.48 6.48 0 0 1 8 14.82v-.9c0-.7.4-1.3.9-1.7l.2-.1c.5-.3.9-.9.7-1.5l-.3-.8c-.1-.3 0-.6.1-.8l1-1.2c.3-.3.7-.5 1.1-.5h.7c.4 0 .8-.1 1.1-.3l.1-.1c.5.9.8 2.1.6 3.3a6.51 6.51 0 0 1-3.8 3.68z"/></svg> Gateway — External Service Access</h5></div>
                <div class="card-body">
                    <p>Once your service is registered, call it through the Gateway with your <strong>API Key</strong> or a <strong>JWT token</strong>:</p>

                    <h6 class="mt-3">cURL</h6>
                    <pre class="bg-light p-3 rounded"><code># With API Key
curl -X GET @Model.GatewayUrl/ext/my-service/health \
  -H "X-API-Key: dn_your_key"

# With JWT token (obtained from /connect/token)
curl -X GET @Model.GatewayUrl/ext/my-service/api/resources \
  -H "Authorization: Bearer eyJ..."</code></pre>

                    <h6 class="mt-3">Python</h6>
                    <pre class="bg-light p-3 rounded"><code>import requests

GATEWAY = "@Model.GatewayUrl"
API_KEY = "dn_your_key"
TOKEN = "eyJ..."  # from /connect/token

# With API Key
r = requests.get(f"{GATEWAY}/ext/my-service/health",
    headers={"X-API-Key": API_KEY})

# With JWT
r = requests.get(f"{GATEWAY}/ext/my-service/api/users",
    headers={"Authorization": f"Bearer {TOKEN}"})</code></pre>

                    <h6 class="mt-3">Node.js (axios)</h6>
                    <pre class="bg-light p-3 rounded"><code>const axios = require('axios');
const GATEWAY = "@Model.GatewayUrl";
const API_KEY = "dn_your_key";
const TOKEN = "eyJ...";

// With API Key
await axios.get(`${GATEWAY}/ext/my-service/health`,
    { headers: { 'X-API-Key': API_KEY } });

// With JWT
await axios.get(`${GATEWAY}/ext/my-service/api/users`,
    { headers: { Authorization: `Bearer ${TOKEN}` } });</code></pre>

                    <h6 class="mt-3">C# (HttpClient)</h6>
                    <pre class="bg-light p-3 rounded"><code>using var client = new HttpClient();
client.BaseAddress = new Uri("@Model.GatewayUrl");

// With API Key
client.DefaultRequestHeaders.Add("X-API-Key", "dn_your_key");
var resp1 = await client.GetAsync("/ext/my-service/health");

// With JWT
client.DefaultRequestHeaders.Authorization =
    new AuthenticationHeaderValue("Bearer", token);
var resp2 = await client.GetAsync("/ext/my-service/api/users");</code></pre>

                    <h6 class="mt-3">Java (OkHttp)</h6>
                    <pre class="bg-light p-3 rounded"><code>OkHttpClient client = new OkHttpClient();

// With API Key
Request req1 = new Request.Builder()
    .url("@Model.GatewayUrl/ext/my-service/health")
    .addHeader("X-API-Key", "dn_your_key")
    .build();
Response r1 = client.newCall(req1).execute();

// With JWT
Request req2 = new Request.Builder()
    .url("@Model.GatewayUrl/ext/my-service/api/users")
    .addHeader("Authorization", "Bearer eyJ...")
    .build();
Response r2 = client.newCall(req2).execute();</code></pre>

                    <h6 class="mt-3">Go</h6>
                    <pre class="bg-light p-3 rounded"><code>package main

import (
    "net/http"
    "fmt"
)

func main() {
    gateway := "@Model.GatewayUrl"
    apiKey := "dn_your_key"
    token := "eyJ..."

    // With API Key
    req1, _ := http.NewRequest("GET", gateway + "/ext/my-service/health", nil)
    req1.Header.Set("X-API-Key", apiKey)

    // With JWT
    req2, _ := http.NewRequest("GET", gateway + "/ext/my-service/api/users", nil)
    req2.Header.Set("Authorization", "Bearer " + token)

    client := &http.Client{}
    client.Do(req1)
    client.Do(req2)
}</code></pre>

                    <h6 class="mt-3">Rust</h6>
                    <pre class="bg-light p-3 rounded"><code>use reqwest;

#[tokio::main]
async fn main() {
    let client = reqwest::Client::new();
    let gateway = "@Model.GatewayUrl";

    // With API Key
    let r1 = client.get(format!("{}/ext/my-service/health", gateway))
        .header("X-API-Key", "dn_your_key")
        .send().await;

    // With JWT
    let r2 = client.get(format!("{}/ext/my-service/api/users", gateway))
        .bearer_auth("eyJ...")
        .send().await;
}</code></pre>

                    <h6 class="mt-3">PHP</h6>
                    <pre class="bg-light p-3 rounded"><code>$gateway = "@Model.GatewayUrl";

// With API Key
$ch1 = curl_init("$gateway/ext/my-service/health");
curl_setopt($ch1, CURLOPT_HTTPHEADER, ["X-API-Key: dn_your_key"]);
curl_exec($ch1);

// With JWT
$ch2 = curl_init("$gateway/ext/my-service/api/users");
curl_setopt($ch2, CURLOPT_HTTPHEADER, ["Authorization: Bearer eyJ..."]);
curl_exec($ch2);</code></pre>

                    <h6 class="mt-3">Ruby</h6>
                    <pre class="bg-light p-3 rounded"><code>require 'net/http'
require 'uri'

gateway = "@Model.GatewayUrl"

# With API Key
uri1 = URI("#{gateway}/ext/my-service/health")
req1 = Net::HTTP::Get.new(uri1)
req1["X-API-Key"] = "dn_your_key"
Net::HTTP.start(uri1.host, uri1.port) { |http| http.request(req1) }

# With JWT
uri2 = URI("#{gateway}/ext/my-service/api/users")
req2 = Net::HTTP::Get.new(uri2)
req2["Authorization"] = "Bearer eyJ..."
Net::HTTP.start(uri2.host, uri2.port) { |http| http.request(req2) }</code></pre>
