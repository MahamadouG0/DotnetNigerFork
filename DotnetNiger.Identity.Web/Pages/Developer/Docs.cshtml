@page
@model DotnetNiger.Identity.Web.Pages.Developer.DocsModel
@{
    ViewData["Title"] = "Documentation";
    // Layout géré par _ViewStart.cshtml
}

<style>
pre { position: relative; }
pre code { font-size: 0.82rem; line-height: 1.6; display: block; overflow-x: auto; }
.copy-btn {
    position: absolute; top: 4px; right: 4px; z-index: 10;
    opacity: 0; transition: opacity 0.2s; font-size: 0.75rem;
    padding: 2px 8px; cursor: pointer;
}
pre:hover .copy-btn { opacity: 1; }
.tab-content { min-height: 300px; }
.nav-tabs .nav-link { font-size: 0.9rem; }
.error-code { font-family: monospace; font-weight: bold; }
</style>

<div class="container py-5" style="max-width:1100px;">
    <h1>Documentation d'intégration</h1>
    <p class="lead">Exemples d'intégration multi-langage pour la plateforme DotnetNiger.</p>

    <div class="mb-3">
        <div class="btn-group" role="group">
            <a href="?lang=fr" class="btn btn-outline-primary @(Model.Lang == "fr" ? "active" : "")">🇫🇷 Français</a>
            <a href="?lang=en" class="btn btn-outline-primary @(Model.Lang == "en" ? "active" : "")">🇬🇧 English</a>
        </div>
    </div>

    @if (Model.Lang == "fr")
    {
        <ul class="nav nav-tabs nav-justified mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="fr-register-tab" data-bs-toggle="tab" data-bs-target="#fr-register" type="button" role="tab"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:-2px"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/><path d="M5 6.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/></svg> Enregistrement</button>
            </li>
