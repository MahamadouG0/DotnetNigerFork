                    </table>

                    <h6 class="mt-4">Example: handle errors in Python</h6>
                    <pre class="bg-light p-3 rounded"><code>import requests

GATEWAY = "@Model.GatewayUrl"
API_KEY = "dn_your_key"

def call_service(path):
    r = requests.get(
        f"{GATEWAY}/ext/my-service/{path}",
        headers={"X-API-Key": API_KEY}
    )
    if r.status_code == 401:
        print("Invalid API key — check your key")
    elif r.status_code == 404:
        print("Service not found — check the slug")
    elif r.status_code == 502:
        print("Upstream service unavailable — retry later")
    elif r.status_code != 200:
        print(f"Error {r.status_code}: {r.text}")
    else:
        return r.json()</code></pre>
