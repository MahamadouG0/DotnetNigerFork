                    <h6 class="mt-4">Exemple : intercepter les erreurs en Python</h6>
                    <pre class="bg-light p-3 rounded"><code>import requests

GATEWAY = "@Model.GatewayUrl"
API_KEY = "dn_ma_cle"

def call_service(path):
    r = requests.get(
        f"{GATEWAY}/ext/mon-service/{path}",
        headers={"X-API-Key": API_KEY}
    )
    if r.status_code == 401:
        print("Clé API invalide — vérifiez votre clé")
    elif r.status_code == 404:
        print("Service introuvable — vérifiez le slug")
    elif r.status_code == 502:
        print("Service distant indisponible — réessayez plus tard")
    elif r.status_code != 200:
        print(f"Erreur {r.status_code}: {r.text}")
    else:
        return r.json()</code></pre>
