                    <h6 class="mt-3">FastAPI (Python)</h6>
                    <pre class="bg-light p-3 rounded"><code>from fastapi import FastAPI, HTTPException
import httpx

GATEWAY = "@Model.GatewayUrl"
API_KEY = "dn_your_key"

app = FastAPI()

async def call_gateway(slug: str, path: str):
    async with httpx.AsyncClient() as client:
        r = await client.get(
            f"{GATEWAY}/ext/{slug}/{path}",
            headers={"X-API-Key": API_KEY}
        )
        if r.status_code != 200:
            raise HTTPException(r.status_code, r.text)
        return r.json()

@@app.get("/api/my-health")
async def health():
    return await call_gateway("my-service", "health")</code></pre>

