                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Cause</th>
                                <th>Solution</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="error-code">401</span></td>
                                <td>Clé API manquante ou invalide</td>
                                <td>Vérifiez l'en-tête <code>X-API-Key</code>. Générez une nouvelle clé depuis le tableau de bord.</td>
                            </tr>
                            <tr>
                                <td><span class="error-code">403</span></td>
                                <td>Token JWT expiré ou invalide</td>
                                <td>Récupérez un nouveau token via <code>/connect/token</code>. Vérifiez les scopes demandés.</td>
                            </tr>
                            <tr>
                                <td><span class="error-code">404</span></td>
                                <td>Slug du service introuvable</td>
                                <td>Vérifiez que le service est enregistré et actif. <code>GET /api/v1/external-services</code> pour lister.</td>
                            </tr>
                            <tr>
                                <td><span class="error-code">429</span></td>
                                <td>Trop de requêtes (rate limiting)</td>
                                <td>Attendez 60 secondes avant de réessayer. Contactez-nous pour augmenter la limite.</td>
                            </tr>
                            <tr>
                                <td><span class="error-code">502</span></td>
                                <td>Service externe injoignable</td>
                                <td>Vérifiez que votre service est actif. Le Gateway abandonne après 30 secondes de timeout.</td>
                            </tr>
                            <tr>
                                <td><span class="error-code">504</span></td>
                                <td>Timeout du service externe</td>
                                <td>Le service distant a mis trop de temps à répondre. Optimisez le temps de réponse.</td>
                            </tr>
                        </tbody>
