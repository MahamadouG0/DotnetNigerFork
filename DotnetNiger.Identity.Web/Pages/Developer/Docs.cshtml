require 'net/http'

module Gateway
  BASE = '@Model.GatewayUrl'
  API_KEY = 'dn_ma_cle'

  def self.get(path)
    uri = URI("#{BASE}#{path}")
    req = Net::HTTP::Get.new(uri)
    req['X-API-Key'] = API_KEY
    Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') do |http|
      http.request(req)
    end
  end
end

class MonController &lt; ApplicationController
  def sante
    response = Gateway.get('/ext/mon-service/health')
    render json: response.body
  end
end</code></pre>

